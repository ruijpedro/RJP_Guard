{
  "version": "3.3.0",
  "storage": "SQLite multi-source",
  "lookup_during_call": "local_only",
  "sources": {
    "CallShield": {
      "mode": "runtime_https_download",
      "url": "https://raw.githubusercontent.com/SysAdminDoc/CallShield/master/data/spam_numbers.json",
      "auto_refresh": "7 days",
      "decision": "possible_scam",
      "safe_contacts_override": true
    },
    "FTC DNC": {
      "mode": "runtime_https_daily_csv",
      "url_template": "https://www.ftc.gov/sites/default/files/DNC_Complaint_Numbers_YYYY-MM-DD.csv",
      "auto_refresh": "1 day",
      "decision": "attention_if_isolated",
      "note": "consumer reports are not verified by FTC"
    }
  }
}
